# Copy this file to .env.local and fill in real values. Never commit .env.local.
# NVIDIA NIM API key. Server-side only.
NVIDIA_NIM_API_KEY=
# ElevenLabs API key. Server-side only.
ELEVENLABS_API_KEY=
# CARTO Basemaps public key. WARNING: NEXT_PUBLIC_* values are visible to every visitor; never put a secret here.
NEXT_PUBLIC_CARTO_API_KEY=
# NVIDIA NIM request timeout in milliseconds (optional, defaults to 30000).
NIM_TIMEOUT_MS=30000
